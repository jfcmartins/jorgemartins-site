---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${post.data.title} — Jorge Martins`} description={post.data.description}>
  <article class="wrap post">
    <a class="back" href={`${base}/blog`}>&larr; Back to blog</a>
    <p class="mono muted small">
      {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <div class="tag-row">
        {post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <div class="content">
      <Content />
    </div>
  </article>

  <style>
    .post {
      padding-block: 3rem 4rem;
      max-width: 720px;
    }

    .back {
      font-size: 0.88rem;
      color: var(--text-muted);
      display: inline-block;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      margin: 0.4rem 0 0.8rem;
    }

    .small {
      font-size: 0.8rem;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 2rem;
    }

    .content {
      font-size: 1.03rem;
      color: var(--text);
    }

    .content :global(h2) {
      margin-top: 2.2rem;
      font-size: 1.35rem;
    }

    .content :global(h3) {
      margin-top: 1.8rem;
      font-size: 1.12rem;
    }

    .content :global(p) {
      color: var(--text);
    }

    .content :global(a) {
      color: var(--link);
    }

    .content :global(ul),
    .content :global(ol) {
      color: var(--text);
    }

    .content :global(blockquote) {
      border-left: 3px solid var(--accent);
      margin: 1.5rem 0;
      padding: 0.2rem 1rem;
      color: var(--text-muted);
    }

    .content :global(img) {
      display: block;
      width: 100%;
      height: auto;
      margin: 1.8rem 0;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .content :global(h2) {
      padding-top: 1.4rem;
      border-top: 1px solid var(--border);
    }

    .content :global(li) {
      margin-bottom: 0.5rem;
    }

    .content :global(li::marker) {
      color: var(--accent);
    }

    .content :global(:not(pre) > code) {
      font-family: var(--mono);
      font-size: 0.88em;
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.1em 0.4em;
    }

    .content :global(.stats) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem;
      margin: 1.8rem 0;
    }

    .content :global(.stats > div) {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1rem;
      text-align: center;
    }

    .content :global(.stats strong) {
      display: block;
      font-size: 1.6rem;
      color: var(--accent-strong);
      line-height: 1.2;
    }

    .content :global(.stats span) {
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    @media (max-width: 520px) {
      .content :global(.stats) {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
